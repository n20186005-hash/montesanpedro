---
import '../styles/global.css';
import { DOMAIN_NAME, SITE_NAME } from '../data/site';
import { localeMeta, hreflangAlternates, type Locale } from '../i18n';
import { attractionSchema, faqSchema } from '../lib/schema';
import type { Content } from '../i18n';

interface Props {
  locale: Locale;
  path: string; // '/' | '/es/' | '/en/'
  content: Content;
}

const { locale, path, content } = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || `https://${DOMAIN_NAME}`;
const canonical = `${siteUrl}${path}`;
const ogImage = `${siteUrl}/og-cover.png`;
const meta = localeMeta[locale];

const alternates = hreflangAlternates(siteUrl);

const attractionJsonLd = attractionSchema(canonical, ogImage);
const faqJsonLd = faqSchema(content.faq);
---
<!doctype html>
<html lang={meta.htmlLang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{content.metaTitle}</title>
  <meta name="description" content={content.metaDescription} />
  <link rel="canonical" href={canonical} />

  {alternates.map((a) => (
    <link rel="alternate" hreflang={a.hreflang} href={a.href} />
  ))}

  <!-- Open Graph / redes sociais -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE_NAME[locale]} />
  <meta property="og:locale" content={meta.ogLocale} />
  <meta property="og:title" content={content.ogTitle} />
  <meta property="og:description" content={content.ogDescription} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content={`${SITE_NAME[locale]}`} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={content.twitterTitle} />
  <meta name="twitter:description" content={content.twitterDescription} />
  <meta name="twitter:image" content={ogImage} />

  <!-- PWA -->
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="theme-color" content="#071f28" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Monte de San Pedro" />

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" />
  <link rel="icon" href="/favicon-16.png" sizes="16x16" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />

  <script type="application/ld+json" set:html={JSON.stringify(attractionJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <script async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-HXM22WWPKP', { anonymize_ip: true });
  </script>
</head>
<body>
  <slot />
  <script is:inline>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', function () {
        navigator.serviceWorker.register('/sw.js').catch(function () {});
      });
    }
  </script>
</body>
</html>
